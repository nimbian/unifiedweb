# systemd unit for the Satchemon frontend (Vite dev server behind Apache/nginx).
# Install to /etc/systemd/system/satchemon-frontend.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now satchemon-frontend
#   sudo systemctl status satchemon-frontend
#
# This runs Vite's *dev* server on 127.0.0.1:5173, matching the current setup
# where Apache reverse-proxies the public hostname to it (see vite.config.ts
# `allowedHosts`). The reverse proxy must forward to 127.0.0.1:5173 — e.g.:
#
#     ProxyPreserveHost On
#     ProxyPass        /api/ http://127.0.0.1:8080/api/      # backend wins for /api
#     ProxyPassReverse /api/ http://127.0.0.1:8080/api/
#     ProxyPass        /     http://127.0.0.1:5173/          # everything else -> Vite
#     ProxyPassReverse /     http://127.0.0.1:5173/
#     # Vite HMR websocket (only needed if you want live reload through the proxy):
#     RewriteEngine On
#     RewriteCond %{HTTP:Upgrade} websocket [NC]
#     RewriteRule /(.*) ws://127.0.0.1:5173/$1 [P,L]
#
# NOTE: the Vite dev server is not meant for production. The hardened path is
# `npm run build` + Apache serving frontend/dist statically (deploy/httpd-satchemon.conf
# + deploy/README.md). In that mode there is no frontend daemon at all — disable
# this unit and only satchemon-api runs.

[Unit]
Description=Satchemon frontend (Vite dev server)
After=network.target satchemon-api.service
Wants=network-online.target

[Service]
Type=simple
User=satchemon
Group=satchemon
WorkingDirectory=/opt/satchemon/frontend
# Vite resolves Node via its `#!/usr/bin/env node` shebang, so Node must be on
# PATH. Adjust if Node comes from nvm or a non-standard prefix (`which node`).
Environment=NODE_ENV=development
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Run the vite binary directly (not `npm run dev`) so systemd supervises the real
# process rather than an npm wrapper. --host 127.0.0.1 keeps it private (Apache
# fronts it); --strictPort fails loudly instead of silently hopping off 5173.
ExecStart=/opt/satchemon/frontend/node_modules/.bin/vite --host 127.0.0.1 --port 5173 --strictPort
Restart=on-failure
RestartSec=5
# Hardening (matches satchemon-api.service). The service user's home is
# /opt/satchemon (not under /home), so ProtectHome does not block it; Vite's
# caches live in node_modules/.vite under WorkingDirectory, which stays writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
