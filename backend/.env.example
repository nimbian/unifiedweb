# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Satchemon API"
ENVIRONMENT=development        # development | production
LOG_LEVEL=INFO

# ── Database (existing PostgreSQL — do NOT let Alembic mutate it) ────────────────
# Matches the legacy config.yml psql block.
DATABASE_URL=postgresql+psycopg://pybot:dbpass@127.0.0.1:5432/dbname

# ── Security / JWT ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-please-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OAuth redirect URI (IMPORTANT) ──────────────────────────────────────────────
# All three providers redirect the browser back to the SPA's /auth/callback route,
# so the redirect URI is just FRONTEND_ORIGIN + /auth/callback. Leave the per-
# provider *_REDIRECT_URI values UNSET below and they are derived from
# FRONTEND_ORIGIN automatically — set the public URL in ONE place (see Frontend).
# Register that exact value (e.g. https://your-domain/auth/callback) in EACH
# provider console. Using localhost here while users reach the site over a real
# domain is the #1 cause of "sign-in failed" for everyone but the local machine.

# ── Discord OAuth (was Flask-Dance) ─────────────────────────────────────────────
# Discord is the primary account: the JWT subject is always the Discord id.
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
# DISCORD_REDIRECT_URI=   # optional override; defaults to FRONTEND_ORIGIN/auth/callback

# ── Google OAuth — the "YouTube" sign-in ────────────────────────────────────────
# YouTube has no OAuth of its own; users authenticate through Google (OpenID
# Connect). Register an OAuth 2.0 Client ID at https://console.cloud.google.com/
# (APIs & Services → Credentials) and add FRONTEND_ORIGIN/auth/callback as an
# authorized redirect. Distinct from GOOGLE_SERVICE_ACCOUNT_FILE below (Drive).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=    # optional override; defaults to FRONTEND_ORIGIN/auth/callback

# ── Twitch OAuth ────────────────────────────────────────────────────────────────
# Register an application at https://dev.twitch.tv/console/apps and add
# FRONTEND_ORIGIN/auth/callback as an OAuth Redirect URL.
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
# TWITCH_REDIRECT_URI=    # optional override; defaults to FRONTEND_ORIGIN/auth/callback

# ── Frontend / CORS ─────────────────────────────────────────────────────────────
# The public URL users load the SPA at. Also the base for every OAuth redirect
# URI above. In production this is your https domain, e.g. https://your-domain.
FRONTEND_ORIGIN=http://localhost:5173
# httpOnly refresh cookie — set true behind HTTPS in production.
COOKIE_SECURE=false

# ── Google Drive slideshow (was app.py /CS) ─────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=gc.json
GOOGLE_DRIVE_FOLDER_ID=1GPKCdlyjwEqDpLsJ5XUV1ak1zr52HF_z

# ── Rolecall / check-in ─────────────────────────────────────────────────────────
# Shared API key required on /api/rolecall requests (the ?apikey=... param).
ROLECALL_API_KEY=your-rolecall-api-key
