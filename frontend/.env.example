# Base URL for the API. In dev, leave as /api so Vite's proxy forwards to uvicorn.
# In production, the reverse proxy serves the SPA and proxies /api to the backend, so /api also works.
VITE_API_BASE_URL=/api

# ── Homepage tiles (Phase 0) ─────────────────────────────────────────────────
# The MooreDnD homepage shows two tiles that link to the EXISTING standalone
# sites for now (nothing behind them changes yet). Point these at the current
# production URLs. In Phase 2 these pages move in-app under /satchemon and
# /dndbattle and these vars fall away.
VITE_SATCHEMON_URL=https://moorednd.com
VITE_DNDBATTLE_URL=https://dndbattle.moorednd.com
