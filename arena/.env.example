# Copy to .env and fill in. NEVER commit .env.
# --- Twitch (chat bot account; needs moderator status in the channel) ---
TWITCH_BOT_USERNAME=your_bot_account
TWITCH_BOT_ID=              # numeric user id of the bot account
TWITCH_CHANNEL=your_channel
TWITCH_BROADCASTER_ID=      # numeric user id of the channel owner (enables EventSub rewards)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_OAUTH_TOKEN=      # user access token for the bot account
TWITCH_BOT_REFRESH_TOKEN=

# --- PostgreSQL (server is the ONLY writer) ---
DATABASE_URL=postgresql://dndarena:changeme@localhost:5432/dndarena

# --- Godot-facing WebSocket (FastAPI) ---
# Behind a reverse proxy keep WS_HOST on loopback — only the proxy faces the
# internet (README "Remote deployment").
WS_HOST=127.0.0.1
WS_PORT=8765
# Shared secret for the overlay feed; required for any non-local deployment.
# Must match `token` in the client's overlay.cfg. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WS_AUTH_TOKEN=

# --- Player website (React SPA + /api, served by the same process) ---
# Public origin of the site (behind the reverse proxy), e.g. https://arena.example.com
# In dev with `npm run dev`: http://localhost:5173. Empty disables Twitch login.
# Add <WEB_BASE_URL>/api/auth/callback to the Twitch app's OAuth Redirect URLs
# (reuses TWITCH_CLIENT_ID/SECRET with an EMPTY scope — identity only).
WEB_BASE_URL=
# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset = ephemeral secret per boot (logins don't survive restarts).
WEB_SESSION_SECRET=
# Built SPA directory (npm run build); missing dir = API-only (dev uses the vite proxy).
WEB_DIST=web/dist

# --- MooreDnD portal-session bridge (PLAN §8) ---
# When the unified MooreDnD portal fronts this server, it sends portal-signed
# RS256 JWTs (Authorization: Bearer ...). We verify them with the portal's
# PUBLIC key only (never the private key) and map the token's twitch_uid onto
# this game's (platform='twitch', platform_user_id) user. The signed-cookie
# Twitch-login flow above remains the fallback. Unset = portal auth off.
# Provide the PEM as a file path (preferred) OR inline; the path wins.
PORTAL_JWT_PUBLIC_KEY_PATH=
# PORTAL_JWT_PUBLIC_KEY=

# --- Game config (hot-reloadable TOML) ---
GAME_CONFIG_PATH=config/game.toml
